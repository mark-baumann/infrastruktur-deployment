# ═══════════════════════════════════════════════════════════════
# .env — Secrets (chmod 600, NIE ins Repo!)
# ═══════════════════════════════════════════════════════════════
# Kopiere diese Datei nach .env und fülle die Werte aus.

# Cloudflare Tunnel Token (aus tunnel-setup.sh)
TUNNEL_TOKEN=

# GitHub Container Registry (für docker pull)
GITHUB_TOKEN=

# Optional: OpenAI API Key (für RAG-Agent, Finanz-Agent)
OPENAI_API_KEY=

# Optional: W&B API Key
WANDB_API_KEY=

# Image-Tag für Rollback (leer = latest)
IMAGE_TAG=
