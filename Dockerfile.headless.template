# ═══════════════════════════════════════════════════════════════
# Dockerfile.headless.template — Template für Headless-Services
# ═══════════════════════════════════════════════════════════════
# Kopiere diese Datei in jedes Headless-Service-Repo als "Dockerfile".
#
# Konventionen:
#   - Kein EXPOSE Port (Headless = kein HTTP)
#   - SERVICE_NAME ARG → Heartbeat-Datei: /tmp/<SERVICE_NAME>-heartbeat.txt
#   - Container schreibt Heartbeat alle 60s via examples/heartbeat.py
#   - Health Check: build-deploy.yml prüft Heartbeat-Alter (max 5 Min)
#
# Grundstein 1 (AUG-225): Multi-Stage-Build (schlankes Runtime-Image, nur
# das venv wird übernommen) + non-root User. Multi-Arch kommt aus der
# python:3.12-slim-Basis + `docker buildx --platform` in build-deploy.yml.

# ── Stage 1: Abhängigkeiten in isoliertem venv bauen ────────────
FROM python:3.12-slim AS builder

WORKDIR /build

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Stage 2: Schlankes Runtime-Image, non-root ──────────────────
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home --uid 1000 appuser
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=appuser:appuser . .

USER appuser

# Service-Name für Heartbeat-Datei (wird beim Build übergeben)
ARG SERVICE_NAME=headless-service
ENV SERVICE_NAME=$SERVICE_NAME

# Kein EXPOSE — Headless-Service hat keinen HTTP-Port
# Kein HTTP-HEALTHCHECK — Heartbeat-Datei wird von außen geprüft

CMD ["python", "app/main.py"]
